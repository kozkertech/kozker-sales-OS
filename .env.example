# =================================================================
# SalesMind Sales OS - Complete Environment Configuration Reference
# =================================================================

# -----------------------------------------------------------------
# 1. MongoDB Database Configuration
# -----------------------------------------------------------------
# Production MongoDB Atlas connection URI:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>.mongodb.net/?retryWrites=true&w=majority

# Local Development MongoDB URI:
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=salesmind

# Legacy backward-compatible variables (optional)
MONGO_URL=mongodb://localhost:27017
DB_NAME=salesmind

# -----------------------------------------------------------------
# 2. Authentication & Security
# -----------------------------------------------------------------
# JWT Secret key for signing authentication tokens
JWT_SECRET=salesmind_super_secret_jwt_key_2026

# Cookie Security: set to 'true' in cloud production (forces SameSite=None; Secure for Vercel <-> Backend HTTPS)
COOKIE_SECURE=false
ENVIRONMENT=development

# Default Initial Administrator Credentials (seeded on first boot)
ADMIN_EMAIL=govind.developer@kozker.com
ADMIN_PASSWORD=SalesMind2026!

# -----------------------------------------------------------------
# 3. CORS & URLs
# -----------------------------------------------------------------
# Backend allowed frontend origin(s) - comma-separated if multiple (e.g. https://your-salesmind.vercel.app,http://localhost:3000)
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Frontend API Target (Set to your deployed backend URL for Vercel, e.g. https://salesmind-backend.onrender.com)
# Leave blank for local Docker Nginx proxy
REACT_APP_BACKEND_URL=

# -----------------------------------------------------------------
# 4. Optional Integrations (AI & Email Delivery)
# -----------------------------------------------------------------
# AI / LLM Provider Key (for Gemini AI field design, lead scoring & copilot)
EMERGENT_LLM_KEY=
GEMINI_API_KEY=

# Email Delivery Provider Key (for Resend sequence emails & team invites)
EMERGENT_EMAIL_KEY=
EMAIL_FROM_NAME=SalesMind
EMAIL_REPLY_TO=
