# =================================================================
# SalesMind Backend - Environment Variables
# =================================================================

# -----------------------------------------------------------------
# 1. Database Configuration (MongoDB Atlas or Local MongoDB)
# -----------------------------------------------------------------
# For MongoDB Atlas (Production):
# MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>.mongodb.net/?retryWrites=true&w=majority
# For Local Development:
MONGODB_URI=mongodb://localhost:27017
# Or use Docker compose service name:
# MONGO_URL=mongodb://salesmind-mongodb:27017

# Database Name (default: salesmind)
MONGODB_DATABASE=salesmind
DB_NAME=salesmind

# -----------------------------------------------------------------
# 2. Server & Security Settings
# -----------------------------------------------------------------
# Port for FastAPI server (Render/Railway/Heroku sets this dynamically via $PORT)
PORT=8000

# JWT secret key for signing authentication tokens (generate a long random string in production)
JWT_SECRET=salesmind_jwt_secret_super_secure_key_2026

# Cookie Security: Set to 'true' for production (enables HTTPS-only SameSite=None cookies for cross-domain Vercel frontend)
COOKIE_SECURE=false
ENVIRONMENT=development

# -----------------------------------------------------------------
# 3. CORS Settings
# -----------------------------------------------------------------
# URL(s) of your deployed Vercel frontend (comma-separated if multiple, e.g. https://salesmind.vercel.app,http://localhost:3000)
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------
# 4. Initial Workspace & Admin Credentials (seeded on first boot)
# -----------------------------------------------------------------
ADMIN_EMAIL=govind.developer@kozker.com
ADMIN_PASSWORD=SalesMind2026!

# -----------------------------------------------------------------
# 5. Optional Integrations (AI & Email Delivery)
# -----------------------------------------------------------------
# Gemini / LLM Provider Key (Optional: for AI suggestions, deal scoring, copilot chat)
EMERGENT_LLM_KEY=
GEMINI_API_KEY=

# Email Provider Key (Optional: for Resend outbound invite & sequence emails)
EMERGENT_EMAIL_KEY=
EMAIL_FROM_NAME=SalesMind
EMAIL_REPLY_TO=
