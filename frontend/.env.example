# =================================================================
# SalesMind Frontend - Environment Variables
# =================================================================

# Production Cloud Backend URL (e.g. https://salesmind-backend.onrender.com or https://api.yourdomain.com)
# For local Docker Nginx proxy, leave this blank.
# For local dev server against local backend, set http://localhost:8000
REACT_APP_BACKEND_URL=

# Local dev server settings (ignored in Vercel production build)
WDS_SOCKET_PORT=443
ENABLE_HEALTH_CHECK=false
